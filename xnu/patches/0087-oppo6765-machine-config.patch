diff --git a/pexpert/pexpert/arm64/OPPO6765.h b/pexpert/pexpert/arm64/OPPO6765.h
new file mode 100644
index 0000000..28dd094
--- /dev/null
+++ b/pexpert/pexpert/arm64/OPPO6765.h
@@ -0,0 +1,94 @@
+/*
+ * Board config for the OPPO A15s (CPH2179, MediaTek MT6765):
+ * eight Cortex-A53 cores, ARMv8.0, no pointer authentication, no PAN.
+ *
+ * Generic ARM like BCM2837 (no APPLE_ARM64_ARCH_FAMILY), GICv3 like VMAPPLE
+ * and SWEET. The GIC has two security states, so every interrupt, including
+ * the virtual timer, is a Group 1 IRQ taken through sleh_irq().
+ *
+ * This target keeps the CPU's 4K translation granule. XNU still uses 16K
+ * software pages because arm_init.c selects PAGE_SHIFT_CONST 14 for memory
+ * larger than 1GB; PAGE_RATIO is 4. Do not define
+ * __ARM_16K_PG__ here: that would program TCR_EL1.TG0 for 16K and break the
+ * bootstrap page tables.
+ */
+
+#ifndef _PEXPERT_ARM64_OPPO6765_H
+#define _PEXPERT_ARM64_OPPO6765_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define OPPO6765                 1
+
+/* Live OPPO framebuffer: base/size from the runtime atag and reserved-memory
+ * data; visible mode from the panel, stride from fb0. The aligned 22MB alias
+ * covers the framebuffer for the early console and final Normal-NC mapping. */
+#define OPPO6765_FB_BASE            0x7b870000
+#define OPPO6765_FB_ALIAS_VA        0xffffffe000200000
+#define OPPO6765_FB_ALIAS_PA        0x7b800000
+#define OPPO6765_FB_ALIAS_OFFSET    (OPPO6765_FB_BASE - OPPO6765_FB_ALIAS_PA)
+#define OPPO6765_FB_WIDTH           720
+#define OPPO6765_FB_HEIGHT          1600
+#define OPPO6765_FB_STRIDE          2944
+#define OPPO6765_FB_ALIAS_BLOCKS     11
+/* The board support code is shared with SWEET; SWEET enables the generic
+ * open-source arm64 platform, framebuffer console and driver paths. */
+#define SWEET                     1
+
+#define OPPO6765_SMP_MAX_CPUS        8
+#define SWEET_SMP_MAX_CPUS         OPPO6765_SMP_MAX_CPUS
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/*
+ * MediaTek uses the standard ARM GIC PPI numbering: the virtual time
+ * (CNTV) is INTID 16 + 11 = 27.
+ */
+#define OPPO6765_VTIMER_INTID       27
+#define SWEET_VTIMER_INTID        OPPO6765_VTIMER_INTID
+#define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
+
+#define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
+
+#define GICR_PE_SIZE              0x20000 // Size of each redistributor region
+
+/* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
+#define GICD_CTLR                 0x0
+
+/* Non-secure view of GICD_CTLR (DS=0) */
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICD_CTLR_ENABLEGRP1A     0x2
+#define GICD_CTLR_ARE_NS          0x10
+#define GICD_CTLR_RWP             0x80000000
+
+#define GICR_TYPER                              0x08
+#define GICR_WAKER                              0x14
+#define GICR_IGROUPR0                           0x10080
+#define GICR_ISENABLER0                         0x10100
+#define GICR_IPRIORITYR0                        0x10400
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT         32
+#define GICR_TYPER_LAST                         0x10
+
+#define GICR_WAKER_PROCESSORSLEEP               0x2
+#define GICR_WAKER_CHILDRENASLEEP               0x4
+
+#define ICC_CTLR_EOIMODE                        0x2
+
+#define ICC_SRE_SRE                             0x1
+/* End of GICv3 register definitions */
+
+#endif /* ! _PEXPERT_ARM64_OPPO6765_H */
