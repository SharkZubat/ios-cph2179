-	add		x11, x11, x13
+	add		x11, x11, x14
 	add		x12, x12, #1
-	str		x11, [x2, x12, lsl #TTE_SHIFT]
+	add		x15, x15, #1
+	cmp		x15, x13
+	b.lo	Lmap_early_fb_alias
 #endif
 
